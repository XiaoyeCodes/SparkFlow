{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "tailwind.config.ts",
    "src/data/marketCalendars.ts",
    "src/data/chinaProvinceEconomy.ts",
    "src/lib/newsTypes.ts",
    "src/lib/dailyBriefTypes.ts",
    "src/lib/financialConditionsTypes.ts",
    "server/**/*.ts",
    "server/**/*.d.ts"
  ]
}
