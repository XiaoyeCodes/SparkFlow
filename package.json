{
  "name": "sparkflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dailyhot:setup": "node scripts/setup-dailyhot.mjs",
    "test:dailyhot": "node scripts/verify-dailyhot-service.mjs",
    "research:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-vibe-trading.ps1",
    "logos:sync": "node scripts/sync-stock-logos.mjs",
    "logos:global": "node scripts/sync-global-heatmap-logos.mjs",
    "logos:global:verify": "node scripts/verify-global-heatmap-logos.mjs",
    "test:macro-cards": "node scripts/verify-us-macro-cards.mjs",
    "test:fed-liquidity": "node scripts/verify-fed-net-liquidity.mjs",
    "test:isolated-market-data": "node --no-warnings --experimental-strip-types scripts/verify-isolated-market-resources.mjs",
    "test:market-cache": "node --no-warnings --experimental-strip-types scripts/verify-daily-market-cache.mjs",
    "test:coze-report": "node --no-warnings --experimental-strip-types scripts/verify-coze-report-pipeline.mjs",
    "predev": "npm run research:setup && npm run dailyhot:setup",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run dailyhot:setup",
    "build": "tsc -b && vite build",
    "prepreview": "npm run dailyhot:setup",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@napi-rs/canvas": "^1.0.6",
    "d3-geo": "^3.1.1",
    "d3-hierarchy": "^3.1.2",
    "face-api.js": "^0.22.2",
    "framer-motion": "^12.23.22",
    "gl-matrix": "^3.4.4",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.468.0",
    "ogl": "^1.0.11",
    "pdfjs-dist": "^4.10.38",
    "postprocessing": "^6.39.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "topojson-client": "^3.1.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^6.21.3",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.184.1",
    "@types/topojson-client": "^3.1.5",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
